# Discord bot token for O Escriba (second application — required from Slice B onward)
RECORDER_TOKEN=your-recorder-bot-token-here

# HTTP server port (default 3000)
PORT=3000

# Shared recordings volume mount path
RECORDINGS_DIR=/data/recordings

# RabbitMQ URL (used from Slice C onward)
RABBITMQ_URL=amqp://rabbitmq:5672

# Comma-separated Discord user IDs to exclude from recording (e.g. music bots)
IGNORED_USER_IDS=
